wannier-dump-name Wannier-atomic-pinned/wannier.$VAR
wannier-initial-state totalE.$VAR
wannier-minimize  \
	dirUpdateScheme      L-BFGS \
	linminMethod         DirUpdateRecommended \
	nIterations          20000 \
	history              15 \
	knormThreshold       0 \
	maxThreshold         no \
	energyDiffThreshold  1e-08 \
	nEnergyDiff          2 \
	convergeAll          no \
	alphaTstart          1 \
	alphaTmin            1e-10 \
	updateTestStepSize   yes \
	alphaTreduceFactor   0.1 \
	alphaTincreaseFactor 3 \
	nAlphaAdjustMax      20 \
	wolfeEnergy          0.0001 \
	wolfeGradient        0.9 \
	abortOnFailedStep    no \
	fdTest               no



